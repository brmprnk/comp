# Version: 0.1.1

# Header
Bootstrap: docker
From: ghcr.io/prefix-dev/pixi:0.48.2

# Files
%files
    pyproject.toml /opt/app/pyproject.toml
    pixi.lock /opt/app/pixi.lock

# Install dependencies
%post
    apt update
    apt install -y git

    cd /opt/app

    # Setup pixi dependencies
    pixi install --all

    # Clean up
    rm -rf ~/.cache/rattler
